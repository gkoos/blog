---
layout: layouts/base.njk
title: Search
permalink: /search/index.html
eleventyExcludeFromCollections: true
---

<h1 class="text-3xl font-bold mb-6">Search</h1>

<div class="not-prose">
  <div id="search-status" role="status" aria-live="polite" class="text-gray-600 dark:text-gray-400 mb-8"></div>
  <div id="search-results" class="space-y-10 [&_mark]:bg-yellow-200 dark:[&_mark]:bg-yellow-500/30 [&_mark]:text-inherit [&_mark]:rounded-sm [&_mark]:px-0.5"></div>
</div>

<script type="module">
  const input = document.getElementById('header-search');
  const statusEl = document.getElementById('search-status');
  const resultsEl = document.getElementById('search-results');

  const query = (new URLSearchParams(window.location.search).get('q') || '').trim();

  if (input) {
    input.value = query;
    if (query) input.focus();
  }

  const escapeHtml = (value) =>
    String(value).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  const renderCard = (result) => {
    const title = escapeHtml(result.meta?.title || result.url);
    const parsed = result.meta?.date ? new Date(result.meta.date) : null;
    const date = parsed && !Number.isNaN(parsed.getTime())
      ? `<time datetime="${parsed.toISOString()}" class="text-sm text-gray-500 dark:text-gray-400">${parsed.toDateString()}</time>`
      : '';
    return `
      <article>
        <h2 class="text-2xl font-semibold mb-2">
          <a href="${escapeHtml(result.url)}" class="text-gray-900 dark:text-white hover:text-gray-700 dark:hover:text-gray-300 transition-colors">${title}</a>
        </h2>
        ${date}
        <p class="mt-2 text-gray-600 dark:text-gray-300 leading-relaxed">${result.excerpt}</p>
      </article>`;
  };

  if (!query) {
    statusEl.textContent = 'Type a search term in the box above and press Enter.';
  } else {
    statusEl.textContent = 'Searching…';
    try {
      const pagefind = await import('/pagefind/pagefind.js');
      const search = await pagefind.search(query);
      const results = await Promise.all(search.results.map((r) => r.data()));

      if (results.length === 0) {
        statusEl.textContent = `No results found for “${query}”.`;
      } else {
        statusEl.textContent = `${results.length} result${results.length === 1 ? '' : 's'} for “${query}”`;
        resultsEl.innerHTML = results.map(renderCard).join('');
      }
    } catch (error) {
      statusEl.textContent = 'Search is unavailable right now. The index is only generated by a production build.';
      console.error(error);
    }
  }
</script>
