---
layout: layouts/base.njk
title: Series
permalink: /series/index.html
---

<h1 class="text-3xl font-bold mb-8">Series</h1>

{% if series.length > 0 %}
<div class="not-prose space-y-4">
  {% for s in series %}
  <details class="group border border-gray-200 dark:border-gray-700 rounded-lg overflow-hidden">
    <summary class="flex items-center justify-between gap-4 cursor-pointer select-none px-5 py-4 text-lg font-semibold text-gray-900 dark:text-gray-100 hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors list-none [&::-webkit-details-marker]:hidden">
      <span>{{ s.title }}</span>
      <span class="flex items-center gap-3 text-sm font-normal text-gray-500 dark:text-gray-400">
        {{ s.posts.length }} part{% if s.posts.length > 1 %}s{% endif %}
        <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </span>
    </summary>
    <ol class="px-5 pb-4 mt-0 space-y-2">
      {% for post in s.posts %}
      <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <a href="{{ post.url }}" class="text-gray-900 dark:text-white hover:text-gray-700 dark:hover:text-gray-300 transition-colors font-medium">{{ post.title }}</a>
        <time datetime="{{ post.date.toISOString() }}" class="text-sm text-gray-500 dark:text-gray-400 whitespace-nowrap">{{ post.date.toDateString() }}</time>
      </li>
      {% endfor %}
    </ol>
  </details>
  {% endfor %}
</div>
{% else %}
<p>No series yet.</p>
{% endif %}
