{% set MCP = ['MCP', '', '1F2937', ''] %}

<h1 class="text-4xl font-bold mb-8">Open Source</h1>

<div class="space-y-8">
  <p class="text-lg">
    I build and maintain open source tools, mostly around reliability, HTTP clients, and developer
    experience. Everything below is open source, pull requests, issues, and feedback are always welcome.
  </p>

  <div class="not-prose space-y-12 mt-8">

    <!-- Fetch-Kit -->
    <section>
      <div class="flex flex-wrap items-center gap-3 mb-2">
        <h2 class="text-2xl font-semibold">
          <a href="https://github.com/fetch-kit" class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:underline">
            <img src="/assets/images/fetch-kit-logo.png" alt="" class="h-8 w-8 object-contain m-0" loading="lazy" />
            Fetch-Kit
          </a>
        </h2>
      </div>
      <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed">
        Making fetch more powerful in production and more testable in development. A toolkit of
        production-ready fetch utilities and chaos-testing tools for JavaScript/TypeScript developers.
      </p>
      <p class="mt-2 text-base">
        <a href="https://fetchkit.org" class="text-blue-600 dark:text-blue-400 hover:underline">fetchkit.org</a>
      </p>
      {{ badges([TS, GO, NODE]) | safe }}

      <div class="space-y-6 mt-6">
        <!-- ffetch -->
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-1">
            <h3 class="text-xl font-semibold">
              <a href="https://github.com/fetch-kit/ffetch" class="text-blue-600 dark:text-blue-400 hover:underline">ffetch</a>
            </h3>
            <img src="https://img.shields.io/github/stars/fetch-kit/ffetch?style=social" alt="GitHub stars for fetch-kit/ffetch" class="h-5 w-auto m-0" loading="lazy" />
          </div>
          <p class="text-base text-gray-700 dark:text-gray-300 leading-relaxed">
            TypeScript-first fetch wrapper with configurable timeouts, retries, and circuit-breaker baked in.
          </p>
          {{ badges([TS, NODE]) | safe }}
        </div>

        <!-- chaos-fetch -->
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-1">
            <h3 class="text-xl font-semibold">
              <a href="https://github.com/fetch-kit/chaos-fetch" class="text-blue-600 dark:text-blue-400 hover:underline">chaos-fetch</a>
            </h3>
            <img src="https://img.shields.io/github/stars/fetch-kit/chaos-fetch?style=social" alt="GitHub stars for fetch-kit/chaos-fetch" class="h-5 w-auto m-0" loading="lazy" />
          </div>
          <p class="text-base text-gray-700 dark:text-gray-300 leading-relaxed">
            Library for injecting network chaos (latency, failures, drops, etc.) into fetch requests.
          </p>
          {{ badges([TS]) | safe }}
        </div>

        <!-- chaos-sw -->
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-1">
            <h3 class="text-xl font-semibold">
              <a href="https://github.com/fetch-kit/chaos-sw" class="text-blue-600 dark:text-blue-400 hover:underline">chaos-sw</a>
