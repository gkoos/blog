            <h3 class="text-xl font-semibold">
              <a href="https://github.com/fetch-kit/chaos-proxy" class="text-blue-600 dark:text-blue-400 hover:underline">chaos-proxy</a>
            </h3>
            <img src="https://img.shields.io/github/stars/fetch-kit/chaos-proxy?style=social" alt="GitHub stars for fetch-kit/chaos-proxy" class="h-5 w-auto m-0" loading="lazy" />
          </div>
          <p class="text-base text-gray-700 dark:text-gray-300 leading-relaxed">
            Proxy for injecting network chaos (latency, failures, drops, rate-limiting) into API requests.
          </p>
          {{ badges([TS, NODE]) | safe }}
        </div>

        <!-- chaos-proxy-go -->
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-1">
            <h3 class="text-xl font-semibold">
              <a href="https://github.com/fetch-kit/chaos-proxy-go" class="text-blue-600 dark:text-blue-400 hover:underline">chaos-proxy-go</a>
