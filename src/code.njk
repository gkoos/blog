            <img src="https://img.shields.io/github/stars/fetch-kit/chaos-sw?style=social" alt="GitHub stars for fetch-kit/chaos-sw" class="h-5 w-auto m-0" loading="lazy" />
          </div>
          <p class="text-base text-gray-700 dark:text-gray-300 leading-relaxed">
            Service Worker for injecting configurable network chaos (latency, failures, throttling, rate-limiting) into browser requests.
          </p>
          {{ badges([TS]) | safe }}
        </div>

        <!-- chaos-proxy -->
        <div>
