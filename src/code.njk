{# Tech-stack badges: small flat-square shields.io badges. #}
{% macro tech(name, slug, color, logoColor) %}<img src="https://img.shields.io/badge/{{ name | replace(' ', '_') }}-{{ color }}?style=flat-square{% if slug %}&amp;logo={{ slug }}&amp;logoColor={{ logoColor }}{% endif %}" alt="{{ name }}" class="h-5 w-auto m-0" loading="lazy" />{% endmacro %}
{% macro badges(items) %}<div class="flex flex-wrap items-center gap-2 mt-3">{% for item in items %}{{ tech(item[0], item[1], item[2], item[3]) | safe }}{% endfor %}</div>{% endmacro %}

{% set TS = ['TypeScript', 'typescript', '3178C6', 'white'] %}
{% set GO = ['Go', 'go', '00ADD8', 'white'] %}
{% set JAVASCRIPT = ['JavaScript', 'javascript', 'F7DF1E', 'black'] %}
{% set SVELTE = ['Svelte', 'svelte', 'FF3E00', 'white'] %}
{% set REDIS = ['Redis', 'redis', 'FF4438', 'white'] %}
{% set POSTGRES = ['PostgreSQL', 'postgresql', '4169E1', 'white'] %}
{% set SQLITE = ['SQLite', 'sqlite', '003B57', 'white'] %}
{% set NODE = ['Node.js', 'nodedotjs', '5FA04E', 'white'] %}
{% set SUPABASE = ['Supabase', 'supabase', '3FCF8E', 'white'] %}
{% set CLOUDFLARE = ['Cloudflare', 'cloudflare', 'F38020', 'white'] %}
{% set MERMAID = ['Mermaid', 'mermaid', 'FF3670', 'white'] %}
